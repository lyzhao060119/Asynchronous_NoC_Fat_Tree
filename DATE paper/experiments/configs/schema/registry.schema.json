{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://date-v3.local/schema/registry.schema.json",
  "title": "DATE V3 run registry index",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "updated_utc", "runs"],
  "properties": {
    "schema": { "const": "date-v3-registry-v1" },
    "updated_utc": { "type": "string" },
    "notes": { "type": "string" },
    "runs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["run_id", "status", "paper_eligible", "physical_class", "manifest"],
        "properties": {
          "run_id": { "type": "string" },
          "design_id": { "type": ["string", "null"] },
          "benchmark_id": { "type": ["string", "null"] },
          "status": { "type": "string" },
          "paper_eligible": { "type": "boolean" },
          "physical_class": { "type": "string" },
          "config_hash": { "type": ["string", "null"] },
          "manifest": { "type": "string" },
          "notes": { "type": "string" }
        }
      }
    }
  }
}
